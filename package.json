    "next": "^15.5.29",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
